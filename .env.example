# cf-bm configuration template. Copy to .env (cp .env.example .env) and fill in your values. .env is gitignored and must never be committed.
# Load it with:  set -a; source .env; set +a

# Cloudflare API token. Needs these permissions: Account > Workers Scripts:Edit, Account > D1:Edit
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID (dashboard > Workers & Pages > right sidebar)
TF_VAR_account_id=

# Your workers.dev subdomain, e.g. "example" if your workers live at *.example.workers.dev
TF_VAR_workers_subdomain=

# Name of the Worker and the D1 database, e.g. "cf-bm". Delete this line rather than leaving it empty.
TF_VAR_worker_name=
